{
  "version": 1,
  "code": "etm",
  "name": "ЭТМ",
  "description": "Шаблон upload_goods из личного кабинета ЭТМ.",
  "writer": {
    "kind": "fill_template",
    "formats": ["xlsx", "xlsm", "csv"],
    "fillable_columns": "yellow_header",
    "mode": "empty_only"
  },
  "article_headers": ["Артикул", "Расширенный артикул"],
  "skip_headers": ["Артикул"],
  "classification": {"header": "81 класс", "field": "class81_code"},
  "value_lists": {"reference": "etm_reference.json", "learned": "etm_value_matches.json"},
  "notes": {
    "default": "В базе нет значения для этого поля.",
    "unit_dimensions": "В базе нет значения для единицы товара. Нужно заполнить именно изделие, не упаковку.",
    "class": "В базе нет категории товара.",
    "tnved": "В базе нет кода ТН ВЭД.",
    "okpd2": "В базе нет кода ОКПД2.",
    "attribute": "В базе нет подходящего значения для этой характеристики.",
    "factory_pack": "В базе нет данных заводской упаковки.",
    "transport_pack": "В базе нет данных транспортной упаковки."
  },
  "note_prefixes": [
    {"prefix": "Конфиг:", "note": "attribute"},
    {"prefix": "Упак3", "note": "factory_pack"},
    {"prefix": "Упак5", "note": "transport_pack"}
  ],
  "fields": [
    {"header": "Код производителя", "const": "2019", "source": "static"},
    {"header": "Страна", "const": "CHN", "source": "static"},
    {"header": "Название упаковки", "const": "шт", "source": "static"},
    {"header": "Расширенный артикул", "field": "article", "source": "products.article"},
    {"header": "81 класс", "field": "class81_code", "source": "ipro_goods/product_etm_class_suggestions.class81_code", "note": "class"},
    {"header": "Название", "field": ["name", "full_name"], "source": "products/ipro_goods.name"},
    {"header": "Полное название", "field": ["full_name", "name"], "source": "ipro_goods.full_name"},
    {"header": "Краткое имя WMS", "field": ["name", "full_name"], "transform": "truncate", "limit": 60, "source": "generated"},
    {"header": "Вес, кг", "field": "weight_kg", "transform": "decimal", "digits": 6, "source": "product_dimensions_resolved.weight_kg/price_snapshot_items.gross_weight_unit", "note": "unit_dimensions"},
    {"header": "Длина, м", "field": "length_mm", "transform": "mm_to_m", "source": "product_dimensions_resolved.length_mm", "note": "unit_dimensions"},
    {"header": "Ширина, м", "field": "width_mm", "transform": "mm_to_m", "source": "product_dimensions_resolved.width_mm", "note": "unit_dimensions"},
    {"header": "Высота, м", "field": "height_mm", "transform": "mm_to_m", "source": "product_dimensions_resolved.height_mm", "note": "unit_dimensions"},
    {"header": "Объем, м3", "field": "volume_m3", "transform": "decimal", "digits": 9, "source": "product_dimensions_resolved/price_snapshot_items.volume_m3", "note": "unit_dimensions"},
    {"header": "Код ТН ВЭД", "field": "tnved_code", "source": "product_tnved_codes.tnved_code", "note": "tnved"},
    {"header": "Код ОКПД2", "field": "okpd2_code", "source": "product_okpd2_codes.okpd2", "note": "okpd2"},
    {"header": "Упак3 Название", "when_present": "min_shipment", "const": "УпЗавод", "source": "generated"},
    {"header": "Упак3 Емкость", "field": "min_shipment", "transform": "count", "source": "price_snapshot_items.min_shipment"},
    {"header": "Упак3 Вес, кг", "field": "package_min_weight_kg", "transform": "decimal", "digits": 6, "source": "price_snapshot_items.gross_weight_min"},
    {"header": "Упак3 Длина, м"},
    {"header": "Упак3 Ширина, м"},
    {"header": "Упак3 Высота, м"},
    {"header": "Упак3 Объем, м3", "field": "package_min_volume_m3", "transform": "decimal", "digits": 9, "source": "price_snapshot_items.min_volume"},
    {"header": "Штрих-код3", "field": "gtin_inner", "source": "material_data_items.gtin_inner", "note": "factory_pack"},
    {"header": "Штрих-код3уп", "when_present": "gtin_inner", "const": "3", "source": "static", "note": "factory_pack"},
    {"header": "Отгрузка кратно УпЗавод", "when_present": "min_shipment", "const": "ДА", "source": "generated", "note": "factory_pack"},
    {"header": "Упак5 Емкость", "field": "pack_multiple", "transform": "count", "source": "price_snapshot_items.pack_multiple"},
    {"header": "Упак5 Вес, кг", "field": "transport_weight_kg", "transform": "decimal", "digits": 6, "source": "price_snapshot_items/material_data_items.transport_weight"},
    {"header": "Упак5 Длина, м", "field": "transport_length_mm", "transform": "mm_to_m", "source": "material_data_items.outer_length_mm"},
    {"header": "Упак5 Ширина, м", "field": "transport_width_mm", "transform": "mm_to_m", "source": "material_data_items.outer_width_mm"},
    {"header": "Упак5 Высота, м", "field": "transport_height_mm", "transform": "mm_to_m", "source": "material_data_items.outer_height_mm"},
    {"header": "Упак5 Объем, м3", "field": "transport_volume_m3", "transform": "decimal", "digits": 9, "source": "price_snapshot_items.transport_volume"},
    {"header": "Штрих-код5", "field": "gtin_outer", "source": "material_data_items.gtin_outer", "note": "transport_pack"},
    {"header": "Штрих-код5уп", "when_present": "gtin_outer", "const": "5", "source": "static", "note": "transport_pack"}
  ],
  "name_aliases": [
    {"characteristic": "Напряжение подсветки, В", "attributes": ["Напряжение питания лампы, В", "Напряжение лампы, В", "Напряжение питания, В"]},
    {"characteristic": "Номинальное напряжение основной вторичной обмотки, В", "attributes": ["Вторичное напряжение 1, В"]},
    {"characteristic": "Номинальное напряжение первичной обмотки, В", "attributes": ["Первичное напряжение 1, В"]},
    {"characteristic": "Количество НЗ контактов", "attributes": ["Количество размыкающих контактов"]},
    {"characteristic": "Количество НО контактов", "attributes": ["Количество замыкающих контактов"]},
    {"characteristic": "Номинальная мощность электродвигателя, КВт", "attributes": ["Номинальная мощность при AC-3, 400 В, кВт", "Номинальная коммутируемая мощность, кВт"]},
    {"characteristic": "Номинальное напряжение питания переменного тока 50 Гц, В", "attributes": ["Номинальное напряжение питания цепи управления Us перемен. тока АС при 50 Гц, В"]},
    {"characteristic": "Тип напряжения (тока)", "attributes": ["Род тока"], "values": {"Переменный ток (AC)": "Переменный (AC)", "Постоянный ток (DC)": "Постоянный (DC)", "Переменный ток (AC)/Постоянный ток (DC)": "Переменный/Постоянный (AC/DC)", "AC": "Переменный (AC)", "DC": "Постоянный (DC)", "AC/DC": "Переменный/Постоянный (AC/DC)"}},
    {"characteristic": "Степень защиты", "attributes": ["Степень защиты (IP)", "Степень защиты IP"]},
    {"characteristic": "Наличие интерфейса связи", "attributes": ["С коммуникационным интерфейсом RS-485"], "values": {"Да": "RS-485"}},
    {"characteristic": "Поддержка протоколов", "attributes": ["Поддержка протокола MODBUS"], "values": {"Да": "Modbus RTU"}, "check": true},
    {"characteristic": "Номинальный ток (А)", "attributes": ["Номинальный ток, А", "Номинальный ток"]},
    {"characteristic": "Номинальная отключающая способность, кA (AC) (IEC/EN 60898)", "attributes": ["Номинальная отключающая способность в соответствии с EN 60898, кА"]},
    {"characteristic": "Номинальное напряжение питания постоянного тока, В", "attributes": ["Номинальное напряжение питания цепи управления Us постоянного тока DC, В", "Номинaльное напряжение питания цепи управления постоянного тока, В"]},
    {"characteristic": "Номинальное напряжение управления (В)", "attributes": ["Номинальное напряжение питания цепи управления, В", "Номинальное напряжение питания цепи управления Us перемен. тока АС при 50 Гц, В", "Номинальное напряжение питания цепи управления Us постоянного тока DC, В"], "check": true},
    {"characteristic": "Сменная лампа", "attributes": ["Тип подсветки"], "values": {"LED несменный": "Нет"}, "only_listed": true},
    {"characteristic": "Наличие возвратного механизма", "attributes": ["С самовозвратом (без фиксации)"]},
    {"characteristic": "Цвет толкателя", "attributes": ["Цвет кнопки"]},
    {"characteristic": "Наличие подсветки", "attributes": ["С подсветкой"]},
    {"characteristic": "Количество силовых полюсов", "attributes": ["Количество полюсов", "Общее количество полюсов"], "values": {"1": "1P", "2": "2P", "3": "3P", "4": "4P"}, "check": true},
    {"characteristic": "Диапазон уставки тока электродвигателя (А)", "attributes": ["Диапазон настройки устройства защиты от перегрузки, А", "Регулируемый диапазон тока, А"]},
    {"characteristic": "Количество аналоговых входов", "attributes": ["Количество аналог входов"]},
    {"characteristic": "Количество аналоговых выходов", "attributes": ["Количество аналог выходов"]},
    {"characteristic": "Количество дискретных входов", "attributes": ["Количество цифров входов"]},
    {"characteristic": "Количество дискретных выходов", "attributes": ["Количество цифров выходов"]},
    {"characteristic": "Типы аналоговых входов", "attributes": ["Диапазон входного сигнала"], "check": true},
    {"characteristic": "Типы аналоговых выходов", "attributes": ["Диапазон выходного сигнала"], "check": true},
    {"characteristic": "Характеристика эл.магнитного расцепителя", "attributes": ["Характеристика срабатывания (кривая тока)", "Характеристика срабатывания"]},
    {"characteristic": "Цвет свечения", "attributes": ["Цвет линзы"], "check": true},
    {"characteristic": "Тип срабатывания по диф.току", "attributes": ["Тип по току утечки", "Тип тока утечки"], "values": {"AС": "AC", "Переменный ток (AC)": "AC"}}
  ],
  "name_rejects": [
    {"characteristic": "Количество НО контактов", "attributes": ["Количество контактных выводов"]},
    {"characteristic": "Количество НЗ контактов", "attributes": ["Количество контактных выводов"]},
    {"characteristic": "Количество переключающих контактов", "attributes": ["Количество контактных выводов", "Количество замыкающих контактов"]},
    {"characteristic": "Импульсный ток Iimp (10/350), кА", "attributes": ["Номинальный импульсный ток (8/20), кА", "Максимальный разрядный ток (8/20), кА"]},
    {"characteristic": "Коммутируемое напряжение, В", "attributes": ["Номинальное напряжение изоляции, В", "Номинальное напряжение изоляции Ui, В", "Напряжение изоляции, B"]},
    {"characteristic": "Цвет толкателя", "attributes": ["Цвет верхней части корпуса"]},
    {"characteristic": "Диапазон регулировки", "attributes": ["Диапазон выходной частоты, Гц", "Диапазон входной частоты, Гц", "Диапазон измерения частоты, Гц"]},
    {"characteristic": "Защитное напряжение (В)", "attributes": ["Степень защиты (IP)", "Степень защиты IP", "Уровень напряжения защиты, кВ"]},
    {"characteristic": "Дифференциальный ток (мА)", "attributes": ["Номинальный ток утечки, А", "Номинальный ток утечки"]}
  ],
  "attribute_columns": [
    {
      "prefix": "Конфиг:",
      "source": "product_attribute_values.attribute_name",
      "rule_source_prefix": "approved_class_rule:",
      "note": "attribute"
    }
  ]
}
